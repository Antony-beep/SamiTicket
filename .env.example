# Supabase: crea un proyecto y copia estas claves públicas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor. Clave service_role del proyecto de demostración; nunca usar NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Deshabilitado por defecto. No hay cobros reales ni pasarela integrada.
DEMO_PAYMENTS_ENABLED=false

# Contacto opcional para el User-Agent. SamiTicket siempre se identifica.
NOMINATIM_CONTACT=
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
# Proveedor de tiles configurable; mantener atribución y su política de uso.
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Opcional: cuenta verificada para npm run seed:demo.
DEMO_OWNER_EMAIL=

# Configura Google, Facebook y Azure (Microsoft) en Supabase Auth > Providers.
# Añade http://localhost:3000/auth/callback y tu URL de producción como Redirect URLs.

# Supabase: crea un proyecto y copia estas claves públicas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor. Clave service_role del proyecto de demostración; nunca usar NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Habilita la simulación local del MVP.
DEMO_PAYMENTS_ENABLED=false

# Verificación de identidad DNId (RENIEC - Inji Verify / Perú Pass).
RENIEC_VERIFICATION_ENABLED=true
RENIEC_VERIFY_BASE_URL=https://verify.inji-reniec.com/v1/verify
RENIEC_CLIENT_ID=did:web:verify.inji-reniec.com:v1:verify
RENIEC_PRESENTATION_DEFINITION_ID=b2c3d4e5-f6a7-8901-bcde-f12345678901
# Opcional: API de consulta por número de DNI (8 dígitos) para autocompletar en producción.
RENIEC_DNI_API_URL=https://api.apis.net.pe/v2/reniec/dni?numero=
RENIEC_DNI_API_TOKEN=

# Resend: envío de la entrada y QR por correo electrónico al comprador.
RESEND_API_KEY=
RESEND_FROM_EMAIL=SamiTicket <onboarding@resend.dev>

# Mercado Pago: usar exclusivamente credenciales de la cuenta ficticia de Perú.
MP_PAYMENTS_ENABLED=false
MP_ENVIRONMENT=test
MP_APP_ID=
MP_TEST_APP_ID=
MP_TEST_SELLER_ID=
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Firma completa de Webhooks; la vista previa de siete caracteres no sirve.
MP_WEBHOOK_SECRET=
# Origen HTTPS del gateway de webhooks de la demo. Retorna a localhost:3000.
APP_URL=

# Contacto opcional para el User-Agent. SamiTicket siempre se identifica.
NOMINATIM_CONTACT=
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
# Proveedor de tiles configurable; mantener atribución y su política de uso.
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Opcional: cuenta verificada para npm run seed:demo.
DEMO_OWNER_EMAIL=

# Configura Google, Facebook y Azure (Microsoft) en Supabase Auth > Providers.
# Añade http://localhost:3000/auth/callback y tu URL de producción como Redirect URLs.
